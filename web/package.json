{
  "name": "todo-web",
  "private": true,
  "type": "module",
  "description": "TypeScript sources for the Todo UI. `npm run build` writes the committed bundles (ui/app.js, ui/vendor/editor.js, tools/harness/harness.js); the Rust build itself needs no Node.",
  "scripts": {
    "build": "npm run build:app && npm run build:editor && npm run build:harness",
    "build:app": "esbuild src/app/main.ts --bundle --format=iife --target=es2022 --outfile=../ui/app.js --legal-comments=none",
    "build:editor": "esbuild src/editor/index.ts --bundle --minify --format=iife --global-name=TodoEditor --target=es2020 --outfile=../ui/vendor/editor.js --legal-comments=none",
    "build:harness": "esbuild src/harness/main.ts --bundle --format=iife --target=es2022 --outfile=../tools/harness/harness.js --legal-comments=none",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.5.0",
    "@replit/codemirror-vim": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "typescript": "^5.9"
  }
}
