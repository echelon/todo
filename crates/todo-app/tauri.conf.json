{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todo",
  "version": "0.1.0",
  "identifier": "ai.storyteller.todo",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Todo",
        "width": 380,
        "height": 540,
        "minWidth": 240,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown-backed todo list that lives in your tray",
    "longDescription": "A tiny, fast todo app. Your lists are plain markdown files; edit them in the app or in any editor and they stay in sync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
